# Public site URL (no trailing slash). Used at build time for <link rel="canonical">,
# og:url, and twitter:url. Required for correct sharing after deploy.
# GitHub Pages (this repo): https://pixellayer7-jpg.github.io/project-estimator
# Vercel: https://your-project.vercel.app
VITE_SITE_URL=

# Formspree form id (path segment only). Create a form at https://formspree.io — if unset,
# the contact section is hidden and users rely on mailto only.
# Example: if your endpoint is https://formspree.io/f/xyzabc, set:
# VITE_FORMSPREE_FORM_ID=xyzabc
VITE_FORMSPREE_FORM_ID=
