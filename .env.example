# Public site URL (no trailing slash). Used at build time for <link rel="canonical">,
# og:url, and twitter:url. Required for correct sharing after deploy.
# When VITE_QUOTE_API_URL is also set, after “Save online copy” the UI shows a second link:
# <this site>/?load=<uuid> so recipients open the calculator with the estimate pre-filled.
# GitHub Pages (this repo): https://pixellayer7-jpg.github.io/project-estimator
# Vercel: https://your-project.vercel.app
VITE_SITE_URL=

# Marketing landing page (for header/footer cross-links)
VITE_LANDING_URL=https://pixellayer7-jpg.github.io/1/

# Formspree form id (path segment only). Create a form at https://formspree.io — if unset,
# the contact section is hidden and users rely on mailto only.
# Example: if your endpoint is https://formspree.io/f/xyzabc, set:
# VITE_FORMSPREE_FORM_ID=xyzabc
VITE_FORMSPREE_FORM_ID=

# Optional: estimator-api base URL (no trailing slash). When set at build time,
# the calculator shows “Save online copy” and POSTs the current snapshot for a shareable link.
# With the same URL, opening the site with ?load=<quote-uuid> (GET /api/v1/quotes/:id) hydrates the form from the server.
# Example: https://your-estimator-api.onrender.com
VITE_QUOTE_API_URL=
